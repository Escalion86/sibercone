# Основные переменные приложения
MONGODB_URI=mongodb://127.0.0.1:27017/sibercone
ADMIN_PASSWORD=change-me
NEXTAUTH_SITE=https://sibercone.ru
NEXTAUTH_SECRET=change-me

# EscalionCloud API работает только на cloud.escalion.ru
# Не используйте escalioncloud.ru или api.escalioncloud.ru
ESCALIONCLOUD_API_URL=https://cloud.escalion.ru/api
ESCALIONCLOUD_PASSWORD=

# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@sibercone.ru

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет 1–256 символов: A-Z, a-z, 0-9, _ и -
TELEGRAM_WEBHOOK_SECRET=
# Необязательный исходящий HTTP-прокси только для Telegram Bot API
# На VPS: http://127.0.0.1:1081
TELEGRAM_PROXY_URL=
# Необязательные прежние получатели через запятую
TELEGRAM_CHAT_IDS=
